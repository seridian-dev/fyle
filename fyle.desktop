[Desktop Entry]
Version=1.0
Name=Fyle
GenericName=File Manager
Comment=A focused workspace for local files
Exec=fyle %u
Icon=fyle
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;
MimeType=inode/directory;text/plain;text/x-rust;text/x-python;application/javascript;application/json;application/x-shellscript;text/html;text/css;text/xml;application/xml;text/markdown;
Keywords=file;manager;files;folder;folders;directory;browse;explorer;finder;
StartupNotify=false
StartupWMClass=fyle
X-GNOME-UsesNotifications=false

# This allows Fyle to be set as the default file manager
X-KDE-Protocols=file
DBusActivatable=false

Actions=new-window;open-home;open-downloads;

[Desktop Action new-window]
Name=New Window
Exec=fyle

[Desktop Action open-home]
Name=Open Home Folder
Exec=fyle --home

[Desktop Action open-downloads]
Name=Open Downloads
Exec=fyle --downloads
